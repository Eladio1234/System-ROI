# ==========================================
# Root .gitignore - Sistema ROI Monorepo
# ==========================================

# Dependencias (Node / NPM / Yarn / PNPM)
node_modules/
backend-roi/node_modules/
frontend-roi/node_modules/
.pnp
.pnp.js

# Variables de Entorno y Credenciales (¡Seguridad Crítica!)
.env
.env.*
!.env.example
backend-roi/.env
frontend-roi/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Compilados y Builds
dist/
dist-ssr/
build/
backend-roi/dist/
frontend-roi/dist/

# Logs de ejecución y errores
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caches de desarrollo y frameworks
.vite/
frontend-roi/.vite/
.eslintcache
.parcel-cache

# Archivos generados en pruebas locales
Reporte_ROI_*.pdf

# Archivos de Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Configuraciones de Editores e IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
